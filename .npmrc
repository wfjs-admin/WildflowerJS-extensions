# Block lifecycle scripts from every package on `npm install`: defense in depth
# against postinstall-based supply-chain attacks. The build never runs
# `npm install` for its toolchain (rollup and terser are fetched as
# SHA-512-pinned tarballs by scripts/fetch-*.cjs); this protects only the
# test dependencies. Side effect: run `npm run test:setup` once for Chromium.
ignore-scripts=true

# Always the canonical registry.
registry=https://registry.npmjs.org/
